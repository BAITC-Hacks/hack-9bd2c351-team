# Runs immediately without credentials using the synthetic electrical catalog.
CATALOG_MODE=demo

# Opt in to live partner lookup. Never use NEXT_PUBLIC_ for credentials.
EKT_API_BASE_URL=https://ekt.kz/api
EKT_API_USERNAME=
EKT_API_PASSWORD=

# Optional read-only natural-language search. No key is needed for demo flows.
# When enabled, user search messages and the last product identity may go to Google.
# Files/OCR stay local and are never sent to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Public origin when running behind a TLS reverse proxy, e.g. https://ekt.kz
APP_ORIGIN=
